// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "sticky_scroll": {
    "enabled": false,
  },
  "languages": {
    "Python": {
      "inlay_hints": {
        "enabled": false,
      },
    },
  },
  "minimap": {
    "thumb": "always",
    "show": "always",
  },
  "ui_font_family": ".ZedSans",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "project_panel": {
    "sticky_scroll": false,
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "edit_predictions": {
    "provider": "copilot",
  },
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "agent": {
    "profiles": {
      
    },
    "default_profile": "ask",
    "sidebar_side": "right",
    "dock": "right",
    "default_model": {
      "enable_thinking": false,
      "provider": "mistral",
      "model": "mistral-large-latest",
    },
    "model_parameters": [],
  },
  "format_on_save": "off",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "icon_theme": "Catppuccin Mocha",
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },
  "ui_font_size": 16,
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Mocha",
    "dark": "Miguel Mocha 3 (Blur) [Heavy]",
  },
}
